global
    log /dev/log local0
    maxconn 2048

defaults
    log global
    mode tcp
    option tcplog
    option dontlognull
    timeout connect 5s
    timeout client 1m
    timeout server 1m
    timeout check 5s

frontend postgresql_write
    bind {{ haproxy_bind_address | default('0.0.0.0') }}:{{ haproxy_postgresql_port | default(5432) }}
    default_backend postgresql_primary

backend postgresql_primary
    mode tcp
    balance first
    option httpchk GET /primary
    http-check expect status 200
    default-server inter 2s fall 3 rise 2 on-marked-down shutdown-sessions
{% for host in groups['postgresql'] %}
    server {{ host }} {{ hostvars[host].ansible_host }}:{{ postgresql_port | default(5432) }} check port {{ patroni_rest_port | default(8008) }}
{% endfor %}
