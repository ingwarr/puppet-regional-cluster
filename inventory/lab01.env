# Region
REGION="lab01"
DOMAIN="lab.example"

# Cluster nodes
PG01_NAME="pg01"
PG01_FQDN="pg01.lab.example"
PG01_IP="192.168.122.223"

PG02_NAME="pg02"
PG02_FQDN="pg02.lab.example"
PG02_IP="192.168.122.244"

PG03_NAME="pg03"
PG03_FQDN="pg03.lab.example"
PG03_IP="192.168.122.222"

# HAProxy
HA01_NAME="ha01"
HA01_FQDN="ha01.lab.example"
HA01_IP="192.168.122.146"

# PostgreSQL service endpoint
POSTGRESQL_SERVICE_NAME="postgres.lab.example"
POSTGRESQL_SERVICE_IP="${HA01_IP}"

HAPROXY_POSTGRES_PORT="5432"
HAPROXY_STATS_PORT="8404"

# etcd
ETCD_VERSION="v3.7.0"

ETCD_CLIENT_PORT="2379"
ETCD_PEER_PORT="2380"

ETCD_DATA_DIR="/var/lib/etcd"
ETCD_CONFIG_DIR="/etc/etcd"

ETCD_CLUSTER_TOKEN="${REGION}-etcd"

ETCD_INITIAL_CLUSTER="${PG01_NAME}=http://${PG01_IP}:${ETCD_PEER_PORT},${PG02_NAME}=http://${PG02_IP}:${ETCD_PEER_PORT},${PG03_NAME}=http://${PG03_IP}:${ETCD_PEER_PORT}"

ETCD_ENDPOINTS="http://${PG01_IP}:${ETCD_CLIENT_PORT},http://${PG02_IP}:${ETCD_CLIENT_PORT},http://${PG03_IP}:${ETCD_CLIENT_PORT}"

# PostgreSQL
POSTGRESQL_MAJOR="16"
POSTGRESQL_PORT="5432"
POSTGRESQL_DATA="/var/lib/pgsql/16/data"

# Patroni
PATRONI_SCOPE="lab01-postgresql"
PATRONI_NAMESPACE="/service/"
PATRONI_REST_PORT="8008"

# Initial laboratory credentials.
# Move these to a secret store before production.
POSTGRES_SUPERUSER="postgres"
POSTGRES_SUPERUSER_PASSWORD="CHANGE_ME_POSTGRES"

POSTGRES_REPLICATION_USER="replicator"
POSTGRES_REPLICATION_PASSWORD="CHANGE_ME_REPLICATION"

PUPPETDB_DB="puppetdb"
PUPPETDB_USER="puppetdb"
PUPPETDB_PASSWORD="CHANGE_ME_PUPPETDB"
